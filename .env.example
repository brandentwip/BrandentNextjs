# Brand Signal server-side configuration. Never use NEXT_PUBLIC_ for these.
# Defaults to OpenAI. For OpenRouter, use https://openrouter.ai/api/v1.
OPENAI_BASE_URL=
OPENAI_API_KEY=
OPENAI_MODEL=nvidia/nemotron-3.5-super-vl:free
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
RESEND_API_KEY=
BRAND_SIGNAL_NOTIFY_EMAIL=
BRAND_SIGNAL_FROM_EMAIL=
